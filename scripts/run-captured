#!/usr/bin/env bash

set -uo pipefail

usage() {
    cat >&2 <<'EOF'
Usage: scripts/run-captured [--log-name NAME] -- COMMAND [ARG ...]

Capture a command's complete output in a temporary log. On failure, print
selected diagnostics and the final 100 lines while preserving the exit status.
EOF
}

log_name=""

while (( $# > 0 )); do
    case "$1" in
        --log-name)
            if (( $# < 2 )); then
                echo "run-captured: --log-name requires a value" >&2
                usage
                exit 2
            fi
            log_name=$2
            shift 2
            ;;
        --)
            shift
            break
            ;;
        -h|--help)
            usage
            exit 0
            ;;
        *)
            echo "run-captured: expected -- before the command" >&2
            usage
            exit 2
            ;;
    esac
done

if (( $# == 0 )); then
    echo "run-captured: no command provided" >&2
    usage
    exit 2
fi

if [[ -z "$log_name" ]]; then
    log_name=${1##*/}
fi

if [[ ! "$log_name" =~ ^[A-Za-z0-9][A-Za-z0-9._-]*$ ]]; then
    echo "run-captured: log name must contain only letters, numbers, '.', '_', or '-'" >&2
    exit 2
fi

umask 077
log=$(mktemp "${TMPDIR:-/tmp}/seter-${log_name}.XXXXXX") || {
    echo "run-captured: could not create a temporary log" >&2
    exit 2
}

if "$@" >"$log" 2>&1; then
    printf 'command succeeded; log: %s\n' "$log"
    exit 0
else
    status=$?
fi

printf 'command failed with exit status %d; log: %s\n' "$status" "$log" >&2
printf '%s\n' '--- selected diagnostics (up to 80 lines) ---' >&2
grep -Ein 'error|failed|failure|traceback|exception|timed out|panic|assert' "$log" \
    | tail -n 80 >&2 || true
printf '%s\n' '--- final 100 lines ---' >&2
tail -n 100 "$log" >&2
exit "$status"
